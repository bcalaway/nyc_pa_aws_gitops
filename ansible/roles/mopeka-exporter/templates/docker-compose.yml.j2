# Rendered by ansible/roles/mopeka-exporter/tasks/main.yml -- not committed
# to Git as a static file, since the proxy hosts vary per site and the API
# keys come from SSM at deploy time. File is mode 0600 (holds the proxy
# PSKs). MOPEKA_PROXIES / MOPEKA_API_KEYS are parallel comma-separated
# lists (same order, same length).
services:
  mopeka-exporter:
    build: .
    container_name: mopeka-exporter
    restart: unless-stopped
    environment:
      MOPEKA_PROXIES: "{{ mopeka_proxy_hosts }}"
      MOPEKA_PROXY_NAMES: "{{ mopeka_proxy_names }}"
      MOPEKA_API_KEYS: "{{ mopeka_api_keys }}"
      METRICS_PORT: "9102"
    ports:
      - "9102:9102"

{
  "title": "AWS Cost",
  "uid": "aws-cost",
  "tags": ["home-platform"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1h",
  "time": { "from": "now-90d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Month to Date",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "aws_cost_month_to_date_usd", "legendFormat": "MTD", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Forecasted Month Total",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "aws_cost_forecast_month_usd", "legendFormat": "Forecast", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Yesterday",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "aws_cost_yesterday_usd", "legendFormat": "Yesterday", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "MTD Gross Usage (before credits)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "aws_cost_month_to_date_gross_usage_usd", "legendFormat": "Gross usage", "refId": "A" }
      ],
      "options": { "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "MTD Credits Applied",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "abs(aws_cost_month_to_date_credits_usd)",
          "legendFormat": "Credits applied",
          "refId": "A"
        }
      ],
      "options": { "graphMode": "area", "colorMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Month-to-Date Trend",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "aws_cost_month_to_date_usd", "legendFormat": "MTD actual (net)", "refId": "A" },
        { "expr": "aws_cost_forecast_month_usd", "legendFormat": "Forecasted total", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Gross Usage vs Credits Applied (MTD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "aws_cost_month_to_date_gross_usage_usd",
          "legendFormat": "Gross usage",
          "refId": "A"
        },
        {
          "expr": "abs(aws_cost_month_to_date_credits_usd)",
          "legendFormat": "Credits applied",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "custom": { "fillOpacity": 15 } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Daily Cost by Service",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "aws_cost_by_service_usd", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    }
  ]
}

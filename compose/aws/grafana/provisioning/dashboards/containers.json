{
  "title": "Containers",
  "uid": "containers",
  "tags": [
    "home-platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "description": "Hub per-container resources from cAdvisor (Milestone 21, ADR-0026).",
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{job=\"cadvisor\"}, name)",
          "refId": "vars"
        },
        "definition": "label_values(container_memory_working_set_bytes{job=\"cadvisor\"}, name)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Containers",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(container_memory_working_set_bytes{job=\"cadvisor\",name=~\"$container\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Container memory (now)",
      "description": "Sum of working sets: what the kernel counts against a mem_limit.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{job=\"cadvisor\",name=~\"$container\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Hub memory used",
      "description": "Whole host, from node-exporter (includes the OS and page cache pressure).",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "1 - node_memory_MemAvailable_bytes{instance=\"aws-hub\"} / node_memory_MemTotal_bytes{instance=\"aws-hub\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "OOM kills (time range)",
      "description": "Kernel OOM kills inside any container over the selected range.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(container_oom_events_total{job=\"cadvisor\",name=~\"$container\"}[$__range])) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Memory sizing (ADR-0026) \u2014 set the time range to 7 days",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "Peak, average and current working set per container over the dashboard's time range. Suggested limit = peak \u00d7 1.3, rounded up to 64 MiB; core services (Postgres, Traefik, Authentik) deserve more headroom than that. Limit shows the container's current mem_limit (none until ADR-0026's limits land).",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "max by (name) (max_over_time(container_memory_working_set_bytes{job=\"cadvisor\",name=~\"$container\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto"
        },
        {
          "expr": "max by (name) (avg_over_time(container_memory_working_set_bytes{job=\"cadvisor\",name=~\"$container\"}[$__range]))",
          "refId": "B",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto"
        },
        {
          "expr": "max by (name) (container_memory_working_set_bytes{job=\"cadvisor\",name=~\"$container\"})",
          "refId": "C",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto"
        },
        {
          "expr": "max by (name) (ceil(max_over_time(container_memory_working_set_bytes{job=\"cadvisor\",name=~\"$container\"}[$__range]) * 1.3 / 67108864) * 67108864)",
          "refId": "D",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto"
        },
        {
          "expr": "max by (name) (container_spec_memory_limit_bytes{job=\"cadvisor\",name=~\"$container\"})",
          "refId": "E",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto"
        },
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name=~\"$container\"}[$__range]))",
          "refId": "F",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto"
        },
        {
          "expr": "max by (name) (container_start_time_seconds{job=\"cadvisor\",name=~\"$container\"}) * 1000",
          "refId": "G",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Container",
              "Value #A": "Peak",
              "Value #B": "Average",
              "Value #C": "Now",
              "Value #D": "Suggested limit",
              "Value #E": "Limit",
              "Value #F": "Avg CPU (cores)",
              "Value #G": "Started"
            },
            "indexByName": {
              "name": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Peak",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Peak"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "max",
                "value": 2147483648
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Suggested limit"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Limit"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "none",
                        "color": "text"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg CPU (cores)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Peak",
            "Average",
            "Now",
            "Suggested limit"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Memory working set by container (stacked)",
      "description": "Working set = RSS + active page cache, the number a mem_limit is enforced against. The dashed line is the hub's physical RAM.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "max by (name) (container_memory_working_set_bytes{job=\"cadvisor\",name=~\"$container\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemTotal_bytes{instance=\"aws-hub\"}",
          "legendFormat": "hub RAM",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hub RAM"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }

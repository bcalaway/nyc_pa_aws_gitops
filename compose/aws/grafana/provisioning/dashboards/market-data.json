{
  "title": "Market data",
  "uid": "market-data",
  "tags": [
    "home-platform",
    "mkt-data"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "mkt-data's holiday calendars (phase 1, Milestone 22): upcoming closes, backfill coverage, capture history and storage. From mkt-data's /metrics (scrape job mkt-data), postgres-exporter and the cost-exporter.",
  "links": [
    {
      "title": "Phase 1 status",
      "type": "link",
      "url": "https://github.com/bcalaway/mkt-data/blob/main/docs/phase-1.md",
      "targetBlank": true,
      "icon": "doc"
    },
    {
      "title": "Airflow",
      "type": "dashboards",
      "tags": [
        "airflow"
      ],
      "asDropdown": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "calendar",
        "label": "Calendar",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(mkt_data_calendar_days, calendar)",
          "refId": "vars"
        },
        "definition": "label_values(mkt_data_calendar_days, calendar)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Database reachable",
      "description": "mkt-data could read its database for this scrape (mkt_data_db_up).",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(mkt_data_db_up)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "red"
                },
                "1": {
                  "text": "Yes",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "title": "Parse failures",
      "description": "Sources whose latest parse failed. The 'Market data parse failed' alert fires on these; home-mcp mkt_data_checks shows the error.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(mkt_data_source_parse_ok{calendar=~\"$calendar\"} == 0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "title": "Oldest successful fetch",
      "description": "Longest time since any source was last fetched or read successfully. The weekly DAGs keep this under 7 days; the stale alert fires past that.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "time() - min(mkt_data_source_last_success_timestamp_seconds{calendar=~\"$calendar\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "never",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 604800
              },
              {
                "color": "red",
                "value": 691200
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "horizontal"
      }
    },

{
  "title": "Propane (Rambles)",
  "uid": "propane",
  "tags": ["home-platform"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "__comment": "Every per-tank panel uses explicit A-F targets in alphabetical order (Prometheus 3.1 here has no sort_by_label, and the Grafana legend has no sort-by-name), so tiles and legend rows stay ordered. Pair colors via byName overrides: Downstairs green, Grill orange, RV blue; Left lighter, Right/2 darker. Adding a tank = a sensors.yaml entry + one target line and one color override in each per-tank panel here.",
  "panels": [
    {
      "id": 1,
      "title": "Tank Fill",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 14, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "instant": true, "expr": "mopeka_sensor_fill_percent{sensor=\"Downstairs Left\"}",  "legendFormat": "Downstairs Left" },
        { "refId": "B", "instant": true, "expr": "mopeka_sensor_fill_percent{sensor=\"Downstairs Right\"}", "legendFormat": "Downstairs Right" },
        { "refId": "C", "instant": true, "expr": "mopeka_sensor_fill_percent{sensor=\"Grill 1\"}",          "legendFormat": "Grill 1" },
        { "refId": "D", "instant": true, "expr": "mopeka_sensor_fill_percent{sensor=\"Grill 2\"}",          "legendFormat": "Grill 2" },
        { "refId": "E", "instant": true, "expr": "mopeka_sensor_fill_percent{sensor=\"RV Left\"}",           "legendFormat": "RV Left" },
        { "refId": "F", "instant": true, "expr": "mopeka_sensor_fill_percent{sensor=\"RV Right\"}",          "legendFormat": "RV Right" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "orange", "value": 20 }, { "color": "green", "value": 40 }
          ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Downstairs Left" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } } ] },
          { "matcher": { "id": "byName", "options": "Downstairs Right" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#37872D" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 1" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FFB357" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 2" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#E0752D" } } ] },
          { "matcher": { "id": "byName", "options": "RV Left" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8AB8FF" } } ] },
          { "matcher": { "id": "byName", "options": "RV Right" },         "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#1F60C4" } } ] }
        ]
      }
    },
    {
      "id": 2,
      "title": "Battery",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "instant": true, "expr": "mopeka_sensor_battery_percent{sensor=\"Downstairs Left\"}",  "legendFormat": "Downstairs Left" },
        { "refId": "B", "instant": true, "expr": "mopeka_sensor_battery_percent{sensor=\"Downstairs Right\"}", "legendFormat": "Downstairs Right" },
        { "refId": "C", "instant": true, "expr": "mopeka_sensor_battery_percent{sensor=\"Grill 1\"}",          "legendFormat": "Grill 1" },
        { "refId": "D", "instant": true, "expr": "mopeka_sensor_battery_percent{sensor=\"Grill 2\"}",          "legendFormat": "Grill 2" },
        { "refId": "E", "instant": true, "expr": "mopeka_sensor_battery_percent{sensor=\"RV Left\"}",           "legendFormat": "RV Left" },
        { "refId": "F", "instant": true, "expr": "mopeka_sensor_battery_percent{sensor=\"RV Right\"}",          "legendFormat": "RV Right" }
      ],
      "options": {
        "graphMode": "none", "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "orange", "value": 20 }, { "color": "green", "value": 40 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Signal (best proxy)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 3, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "instant": true, "expr": "max by (sensor) (mopeka_sensor_signal_dbm{sensor=\"Downstairs Left\"})",  "legendFormat": "Downstairs Left" },
        { "refId": "B", "instant": true, "expr": "max by (sensor) (mopeka_sensor_signal_dbm{sensor=\"Downstairs Right\"})", "legendFormat": "Downstairs Right" },
        { "refId": "C", "instant": true, "expr": "max by (sensor) (mopeka_sensor_signal_dbm{sensor=\"Grill 1\"})",          "legendFormat": "Grill 1" },
        { "refId": "D", "instant": true, "expr": "max by (sensor) (mopeka_sensor_signal_dbm{sensor=\"Grill 2\"})",          "legendFormat": "Grill 2" },
        { "refId": "E", "instant": true, "expr": "max by (sensor) (mopeka_sensor_signal_dbm{sensor=\"RV Left\"})",           "legendFormat": "RV Left" },
        { "refId": "F", "instant": true, "expr": "max by (sensor) (mopeka_sensor_signal_dbm{sensor=\"RV Right\"})",          "legendFormat": "RV Right" }
      ],
      "options": {
        "graphMode": "none", "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "orange", "value": -95 }, { "color": "green", "value": -85 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Proxies",
      "type": "stat",
      "gridPos": { "h": 7, "w": 3, "x": 21, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "instant": true, "expr": "mopeka_proxy_up{proxy=\"10.0.2.123\"}", "legendFormat": "10.0.2.123" },
        { "refId": "B", "instant": true, "expr": "mopeka_proxy_up{proxy=\"10.0.2.127\"}", "legendFormat": "10.0.2.127" }
      ],
      "options": {
        "graphMode": "none", "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "Up", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "green", "value": 1 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Fill % History",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "mopeka_sensor_fill_percent{sensor=\"Downstairs Left\"}",  "legendFormat": "Downstairs Left" },
        { "refId": "B", "expr": "mopeka_sensor_fill_percent{sensor=\"Downstairs Right\"}", "legendFormat": "Downstairs Right" },
        { "refId": "C", "expr": "mopeka_sensor_fill_percent{sensor=\"Grill 1\"}",          "legendFormat": "Grill 1" },
        { "refId": "D", "expr": "mopeka_sensor_fill_percent{sensor=\"Grill 2\"}",          "legendFormat": "Grill 2" },
        { "refId": "E", "expr": "mopeka_sensor_fill_percent{sensor=\"RV Left\"}",           "legendFormat": "RV Left" },
        { "refId": "F", "expr": "mopeka_sensor_fill_percent{sensor=\"RV Right\"}",          "legendFormat": "RV Right" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "spanNulls": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Downstairs Left" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } } ] },
          { "matcher": { "id": "byName", "options": "Downstairs Right" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#37872D" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 1" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FFB357" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 2" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#E0752D" } } ] },
          { "matcher": { "id": "byName", "options": "RV Left" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8AB8FF" } } ] },
          { "matcher": { "id": "byName", "options": "RV Right" },         "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#1F60C4" } } ] }
        ]
      }
    },
    {
      "id": 6,
      "title": "Raw Level (mm above sensor)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "mopeka_sensor_tank_level_mm{sensor=\"Downstairs Left\"}",  "legendFormat": "Downstairs Left" },
        { "refId": "B", "expr": "mopeka_sensor_tank_level_mm{sensor=\"Downstairs Right\"}", "legendFormat": "Downstairs Right" },
        { "refId": "C", "expr": "mopeka_sensor_tank_level_mm{sensor=\"Grill 1\"}",          "legendFormat": "Grill 1" },
        { "refId": "D", "expr": "mopeka_sensor_tank_level_mm{sensor=\"Grill 2\"}",          "legendFormat": "Grill 2" },
        { "refId": "E", "expr": "mopeka_sensor_tank_level_mm{sensor=\"RV Left\"}",           "legendFormat": "RV Left" },
        { "refId": "F", "expr": "mopeka_sensor_tank_level_mm{sensor=\"RV Right\"}",          "legendFormat": "RV Right" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "fieldConfig": {
        "defaults": { "unit": "lengthmm", "custom": { "spanNulls": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Downstairs Left" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } } ] },
          { "matcher": { "id": "byName", "options": "Downstairs Right" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#37872D" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 1" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FFB357" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 2" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#E0752D" } } ] },
          { "matcher": { "id": "byName", "options": "RV Left" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8AB8FF" } } ] },
          { "matcher": { "id": "byName", "options": "RV Right" },         "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#1F60C4" } } ] }
        ]
      }
    },
    {
      "id": 7,
      "title": "Battery Voltage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "mopeka_sensor_battery_volts{sensor=\"Downstairs Left\"}",  "legendFormat": "Downstairs Left" },
        { "refId": "B", "expr": "mopeka_sensor_battery_volts{sensor=\"Downstairs Right\"}", "legendFormat": "Downstairs Right" },
        { "refId": "C", "expr": "mopeka_sensor_battery_volts{sensor=\"Grill 1\"}",          "legendFormat": "Grill 1" },
        { "refId": "D", "expr": "mopeka_sensor_battery_volts{sensor=\"Grill 2\"}",          "legendFormat": "Grill 2" },
        { "refId": "E", "expr": "mopeka_sensor_battery_volts{sensor=\"RV Left\"}",           "legendFormat": "RV Left" },
        { "refId": "F", "expr": "mopeka_sensor_battery_volts{sensor=\"RV Right\"}",          "legendFormat": "RV Right" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "fieldConfig": {
        "defaults": { "unit": "volt", "decimals": 2, "custom": { "spanNulls": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Downstairs Left" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } } ] },
          { "matcher": { "id": "byName", "options": "Downstairs Right" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#37872D" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 1" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FFB357" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 2" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#E0752D" } } ] },
          { "matcher": { "id": "byName", "options": "RV Left" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8AB8FF" } } ] },
          { "matcher": { "id": "byName", "options": "RV Right" },         "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#1F60C4" } } ] }
        ]
      }
    },
    {
      "id": 8,
      "title": "Sensor Temperature",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "mopeka_sensor_temperature_celsius{sensor=\"Downstairs Left\"} * 9 / 5 + 32",  "legendFormat": "Downstairs Left" },
        { "refId": "B", "expr": "mopeka_sensor_temperature_celsius{sensor=\"Downstairs Right\"} * 9 / 5 + 32", "legendFormat": "Downstairs Right" },
        { "refId": "C", "expr": "mopeka_sensor_temperature_celsius{sensor=\"Grill 1\"} * 9 / 5 + 32",          "legendFormat": "Grill 1" },
        { "refId": "D", "expr": "mopeka_sensor_temperature_celsius{sensor=\"Grill 2\"} * 9 / 5 + 32",          "legendFormat": "Grill 2" },
        { "refId": "E", "expr": "mopeka_sensor_temperature_celsius{sensor=\"RV Left\"} * 9 / 5 + 32",           "legendFormat": "RV Left" },
        { "refId": "F", "expr": "mopeka_sensor_temperature_celsius{sensor=\"RV Right\"} * 9 / 5 + 32",          "legendFormat": "RV Right" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "fieldConfig": {
        "defaults": { "unit": "fahrenheit", "decimals": 1, "custom": { "spanNulls": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Downstairs Left" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } } ] },
          { "matcher": { "id": "byName", "options": "Downstairs Right" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#37872D" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 1" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FFB357" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 2" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#E0752D" } } ] },
          { "matcher": { "id": "byName", "options": "RV Left" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8AB8FF" } } ] },
          { "matcher": { "id": "byName", "options": "RV Right" },         "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#1F60C4" } } ] }
        ]
      }
    },
    {
      "id": 9,
      "title": "Reading Quality",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "mopeka_sensor_reading_quality_percent{sensor=\"Downstairs Left\"}",  "legendFormat": "Downstairs Left" },
        { "refId": "B", "expr": "mopeka_sensor_reading_quality_percent{sensor=\"Downstairs Right\"}", "legendFormat": "Downstairs Right" },
        { "refId": "C", "expr": "mopeka_sensor_reading_quality_percent{sensor=\"Grill 1\"}",          "legendFormat": "Grill 1" },
        { "refId": "D", "expr": "mopeka_sensor_reading_quality_percent{sensor=\"Grill 2\"}",          "legendFormat": "Grill 2" },
        { "refId": "E", "expr": "mopeka_sensor_reading_quality_percent{sensor=\"RV Left\"}",           "legendFormat": "RV Left" },
        { "refId": "F", "expr": "mopeka_sensor_reading_quality_percent{sensor=\"RV Right\"}",          "legendFormat": "RV Right" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "spanNulls": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Downstairs Left" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } } ] },
          { "matcher": { "id": "byName", "options": "Downstairs Right" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#37872D" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 1" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FFB357" } } ] },
          { "matcher": { "id": "byName", "options": "Grill 2" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#E0752D" } } ] },
          { "matcher": { "id": "byName", "options": "RV Left" },          "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8AB8FF" } } ] },
          { "matcher": { "id": "byName", "options": "RV Right" },         "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#1F60C4" } } ] }
        ]
      }
    },
    {
      "id": 10,
      "title": "Data Age (last reading, any tank)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "time() - max(mopeka_sensor_last_seen_timestamp_seconds)", "refId": "A", "instant": true }
      ],
      "options": { "graphMode": "none", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 900 }, { "color": "red", "value": 3600 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "BLE Signal per Sensor per Proxy",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "mopeka_sensor_signal_dbm", "legendFormat": "{{sensor}} via {{proxy}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "dBm", "decimals": 0, "custom": { "spanNulls": true } },
        "overrides": []
      }
    }
  ]
}

{
  "title": "Propane (Rambles)",
  "uid": "propane",
  "tags": ["home-platform"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Tank Level (raw mm — pending calibration)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 7, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "mopeka_sensor_tank_level_mm", "legendFormat": "{{sensor}}", "refId": "A" }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": {
        "defaults": { "unit": "lengthmm", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Battery",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 7, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "mopeka_sensor_battery_percent", "legendFormat": "{{sensor}}", "refId": "A" }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 40 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Signal (best proxy)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "max by (sensor) (mopeka_sensor_signal_dbm)", "legendFormat": "{{sensor}}", "refId": "A" }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -95 },
              { "color": "green", "value": -85 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Proxies",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "mopeka_proxy_up", "legendFormat": "{{proxy}}", "refId": "A" }],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "Up", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Data Age",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "time() - max(mopeka_exporter_last_success_timestamp_seconds)", "refId": "A" }
      ],
      "options": { "graphMode": "none", "colorMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 600 },
              { "color": "red", "value": 3600 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Tank Level History (raw mm)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "mopeka_sensor_tank_level_mm", "legendFormat": "{{sensor}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "lengthmm", "custom": { "spanNulls": true } },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Battery Voltage",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "mopeka_sensor_battery_volts", "legendFormat": "{{sensor}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "volt", "decimals": 2, "custom": { "spanNulls": true } },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Sensor Temperature",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "mopeka_sensor_temperature_celsius", "legendFormat": "{{sensor}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "celsius", "decimals": 1, "custom": { "spanNulls": true } },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Reading Quality",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "mopeka_sensor_reading_quality_percent", "legendFormat": "{{sensor}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "spanNulls": true } },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "BLE Signal per Sensor per Proxy",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "mopeka_sensor_signal_dbm", "legendFormat": "{{sensor}} via {{proxy}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "dBm", "decimals": 0, "custom": { "spanNulls": true } },
        "overrides": []
      }
    }
  ]
}

[Unit]
Description=Voice coding-task runner (Milestone 18, ADR-0021)
After=docker.service network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/voice-worker/runner.py
Restart=always
RestartSec=5
# Logs go to the journal -> the NUC's syslog forwarding -> Loki.

[Install]
WantedBy=multi-user.target

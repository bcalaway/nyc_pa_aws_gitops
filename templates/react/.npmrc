# eslint-plugin-react 7.37 declares eslint up to ^9.7 as its peer, and the
# template is on ESLint 10. The plugin stays installed (the lockfile pins it)
# but unused in eslint.config.js until a release supports ESLint 10. With
# legacy-peer-deps npm installs no peer dependencies, so @testing-library/dom
# is an explicit dev dependency.
legacy-peer-deps=true
